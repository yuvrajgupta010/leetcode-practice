7
8  const dfs = (node, color) => {
9    colorTracker[node] = color;
10
11    for (let adjacentNode of graph[node]) {
12      if (colorTracker[adjacentNode] === -1) {
13        if (!dfs(adjacentNode, 1 - color)) {
14          return false;
15        }
16      } else if (colorTracker[adjacentNode] === color) {
17        return false;
18      }
19    }
20
21    return true;
22  };
23
24  for (let i = 0; i < graph.length; i++) {
25    if (colorTracker[i] === -1) {
26      if (!dfs(i, 0)) {
27        return false;
28      }
29    }
30  }
31
32  return true;
33};
