1/**
2 * @param {number[][]} graph
3 * @return {boolean}
4 */
5var isBipartite = function (graph) {
6  const colorTracker = Array.from({ length: graph.length }, () => -1);
7
8  for (let i = 0; i < graph.length; i++) {
9    if (colorTracker[i] !== -1) continue;
10
11    const queue = [];
12    queue.push(i);
13    colorTracker[i] = 0;
14    while (queue.length) {
15      const node = queue.shift();
16
17      for (let adjacentNode of graph[node]) {
18        if (colorTracker[adjacentNode] === colorTracker[node]) return false;
19        if (colorTracker[adjacentNode] === -1) {
20          queue.push(adjacentNode);
21          colorTracker[adjacentNode] = colorTracker[node] ? 0 : 1;
22        }
23      }
24    }
25  }
26  return true;
27};
