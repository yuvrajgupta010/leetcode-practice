5var isBipartite = function (graph) {
6  const v1 = new Set();
7  const v2 = new Set();
8
9  for (let start = 0; start < graph.length; start++) {
10    if (v1.has(start) || v2.has(start)) continue;
11
12    const queue = [start];
13    v1.add(start);
14    let currV = "v1";
15
16    while (queue.length) {
17      const layerSize = queue.length;
18
19      for (let i = 0; i < layerSize; i++) {
20        const node = queue.shift();
21
22        if (currV === "v1") {
23          for (let next of graph[node]) {
24            if (v1.has(next)) return false;
25
26            if (!v2.has(next)) {
27              v2.add(next);
28              queue.push(next);
29            }
30          }
31        } else {
32          for (let next of graph[node]) {
33            if (v2.has(next)) return false;
34
35            if (!v1.has(next)) {
36              v1.add(next);
37              queue.push(next);
38            }
39          }
40        }
41      }
42
43      currV = currV === "v1" ? "v2" : "v1";
44    }
45  }
46
47  return true;
48};
